# ==========================================
# TRACKPULSE - REAL-TIME TELEMETRY & API CONFIGURATION
# SIH Problem Statement: SIH26028 (Ministry of Railways)
# ==========================================

# Application Environment
NEXT_PUBLIC_APP_NAME=TrackPulse
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_ENVIRONMENT=production

# ------------------------------------------
# 1. OFFICIAL INDIAN RAILWAY LIVE FEEDS (Optional)
# If provided, the system directly ingests live NTES/CRIS RTIS GPS feeds.
# If omitted, TrackPulse uses its high-fidelity point-in-time dynamic telemetry engine.
# ------------------------------------------
CRIS_API_KEY=
NTES_CLIENT_ID=
NTES_CLIENT_SECRET=

# ------------------------------------------
# 2. RAPIDAPI / THIRD-PARTY RAILWAY RUNNING STATUS (Optional)
# Standard live running status API feed from RapidAPI / RailYatri / IRCTC partners.
# ------------------------------------------
RAPIDAPI_KEY=
IRCTC_PARTNER_KEY=

# ------------------------------------------
# 3. LIVE ROUTE WEATHER TELEMETRY (Optional)
# Ingests live fog visibility, monsoon rainfall, and wind conditions along train coordinates.
# ------------------------------------------
OPENWEATHER_API_KEY=

# ------------------------------------------
# 4. PHYSICAL PHONE SMS GATEWAYS (Optional)
# Connects actual physical phone SMS to TrackPulse's inbound webhook (/api/sms/inbound).
# ------------------------------------------
# Twilio Gateway:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Indian Fast2SMS / Textlocal Gateway:
FAST2SMS_API_KEY=
TEXTLOCAL_API_KEY=
